<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme for splash (blue background while Flutter loads) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowStatusBarColor">@color/primary_blue</item>
        <item name="android:windowNavigationBarColor">@color/primary_blue</item>
    </style>

    <!-- Normal theme applied after Flutter is initialized -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowStatusBarColor">@color/primary_blue</item>
    </style>
</resources>
